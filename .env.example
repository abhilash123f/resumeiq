# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/resume-matcher

# JWT
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# AI Provider Configuration (openai, gemini, anthropic)
AI_PROVIDER=openai

# TODO: ADD API KEY - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# TODO: ADD API KEY - Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# TODO: ADD API KEY - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=...

# Embedding Provider (openai, cohere, huggingface)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# TODO: ADD API KEY - Get from https://cohere.com/
COHERE_API_KEY=...

# LLM Configuration
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# Vector Store (memory, pinecone, redis)
VECTOR_STORE=memory

# TODO: ADD API KEY - Get from https://www.pinecone.io/
PINECONE_API_KEY=...
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=resume-matcher

# Redis (for vector store or caching)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
